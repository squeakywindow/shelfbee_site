---
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_STORE_URL } from "../config";

const values = [
  {
    icon: "📖",
    title: "Ebooks & audiobooks",
    body: "Both formats, checked per library, with live hold counts and wait estimates.",
  },
  {
    icon: "🐝",
    title: "Your shelf of libraries",
    body: "Save every library card you hold. Star a favorite to float it to the top.",
  },
  {
    icon: "🎧",
    title: "One tap to your book",
    body: "Available now, on hold, or coming soon — jump straight to your library to borrow.",
  },
];

const steps = [
  {
    n: 1,
    title: "Enable the extension",
    body: "Open Settings → Safari → Extensions and switch on ShelfBee.",
  },
  {
    n: 2,
    title: "Add your libraries",
    body: "Click the 🐝 toolbar icon and search for every library you belong to (restrictions apply).",
  },
  {
    n: 3,
    title: "Browse as usual",
    body: "Open any book on Amazon or Goodreads — availability appears at the top.",
  },
];
---

<BaseLayout title="Read more, wait less">
  <div class="wrap">
    <section class="hero">
      <div class="copy">
        <p class="eyebrow">Safari extension</p>
        <h1>Read more,<br /><span class="u">wait less.</span></h1>
        <p class="sub">
          ShelfBee checks your library's digital collection the moment you land on a book. Find your next read quicker.
        </p>
        <div class="actions">
          <a class="cta" href={APP_STORE_URL}>
            <img src="/assets/toolbar-glyph-white.svg" alt="" width="16" height="16" />
            Add to Safari
          </a>
          <a class="ghost" href="/how-it-works">See how it works →</a>
        </div>
      </div>
      <div class="heroart">
        <img src="/assets/mark-bee.svg" alt="ShelfBee" />
      </div>
    </section>

    <section class="values">
      {values.map((v) => (
        <div class="v">
          <div class="ic">{v.icon}</div>
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </section>

    <section class="steps">
      <h2>Turn it on in Safari</h2>
      <p class="lead">ShelfBee lives in your Safari toolbar. Two taps and you're set.</p>
      <div class="flow">
        {steps.map((s) => (
          <div class="step">
            <div class="num">{s.n}</div>
            <h4>{s.title}</h4>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 12px 40px 52px;
  }

  /* hero */
  .hero {
    display: flex;
    gap: 48px;
    align-items: center;
    margin-bottom: 52px;
  }

  .copy {
    flex: 1;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--brand-tan);
    letter-spacing: 0.04em;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  h1 {
    font-size: 52px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    font-weight: var(--fw-bold);
  }

  h1 .u {
    background: linear-gradient(120deg, #ff8a3d, #ff4d6d);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .sub {
    font-size: var(--fs-subhead);
    line-height: 1.5;
    color: var(--brand-plum-2);
    max-width: 440px;
    margin: 0 0 26px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-sunset);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-subhead);
    border: 0;
    border-radius: 12px;
    padding: 11px 20px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(255, 77, 109, 0.28);
    white-space: nowrap;
  }

  .ghost {
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    color: var(--brand-plum-2);
  }

  .heroart {
    width: 300px;
    height: 300px;
    border-radius: var(--r-tile);
    background: var(--brand-sunset);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-tile);
  }

  .heroart img {
    width: 78%;
    height: 78%;
  }

  /* value row */
  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 48px;
  }

  .v {
    background: #fff;
    border: 1px solid var(--brand-line);
    border-radius: var(--r-card);
    padding: 22px;
  }

  .v .ic {
    font-size: 26px;
    margin-bottom: 12px;
  }

  .v h3 {
    font-size: var(--fs-subhead);
    margin: 0 0 6px;
    font-weight: var(--fw-semibold);
  }

  .v p {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--brand-plum-2);
    margin: 0;
  }

  /* onboarding */
  .steps {
    background: #fff;
    border: 1px solid var(--brand-line);
    border-radius: var(--r-panel);
    padding: 30px 34px;
  }

  .steps h2 {
    font-size: var(--fs-heading);
    margin: 0 0 4px;
    font-weight: var(--fw-semibold);
  }

  .steps .lead {
    font-size: var(--fs-body);
    color: var(--brand-plum-2);
    margin: 0 0 24px;
  }

  .flow {
    display: flex;
    gap: 20px;
  }

  .step {
    flex: 1;
  }

  .num {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand-cream-2);
    border: 1px solid var(--brand-line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--fs-name);
    font-weight: var(--fw-bold);
    color: var(--brand-sunset-2);
    margin-bottom: 12px;
  }

  .step h4 {
    font-size: var(--fs-subhead);
    margin: 0 0 5px;
    font-weight: var(--fw-semibold);
  }

  .step p {
    font-size: var(--fs-name);
    line-height: 1.5;
    color: var(--brand-plum-3);
    margin: 0;
  }

  @media (max-width: 720px) {
    .wrap {
      padding: 12px 20px 40px;
    }
    .hero {
      flex-direction: column-reverse;
      gap: 32px;
    }
    .heroart {
      width: 200px;
      height: 200px;
    }
    h1 {
      font-size: 38px;
    }
    .values,
    .flow {
      grid-template-columns: 1fr;
      flex-direction: column;
    }
  }
</style>
